# Vivado needs these checker manifests when it builds the first simulation
# compile order. The checker HDL itself is generated locally.
!project/keccak_soc/keccak_soc.gen/
!project/keccak_soc_ila/keccak_soc_ila.gen/
/project/keccak_soc*/keccak_soc*.gen/*
!/project/keccak_soc*/keccak_soc*.gen/sources_1/
/project/keccak_soc*/keccak_soc*.gen/sources_1/*
!/project/keccak_soc*/keccak_soc*.gen/sources_1/ip/
/project/keccak_soc*/keccak_soc*.gen/sources_1/ip/*
!/project/keccak_soc*/keccak_soc*.gen/sources_1/ip/axi_protocol_checker_0/
!/project/keccak_soc*/keccak_soc*.gen/sources_1/ip/axis_protocol_checker_0/
/project/keccak_soc*/keccak_soc*.gen/sources_1/ip/*/*
!/project/keccak_soc*/keccak_soc*.gen/sources_1/ip/axi_protocol_checker_0/axi_protocol_checker_0.xml
!/project/keccak_soc*/keccak_soc*.gen/sources_1/ip/axis_protocol_checker_0/axis_protocol_checker_0.xml
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
